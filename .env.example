# Local development only. Replace values with protected service credentials for real integrations.
# This example DSN is for the PostgreSQL service in docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://codemind:codemind_dev_only@localhost:5432/codemind
DATABASE_CONNECT_TIMEOUT_SECONDS=2
CODEMIND_API_INTERNAL_URL=http://127.0.0.1:8000

# Local-only compose setting. Never use this development password in a deployed environment.
POSTGRES_DB=codemind
POSTGRES_USER=codemind
POSTGRES_PASSWORD=codemind_dev_only
REDIS_URL=redis://localhost:6379/0

# Configure these only when the corresponding real service is available.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GROQ_API_KEY=
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
